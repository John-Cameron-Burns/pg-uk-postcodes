FROM (VALUES ('IR', '۱۱۴۱۶۱۳۶۷۵'), ('IR', '۱۱۵۱۷-۱۳۵۱۳'), ('MM', '၀၇၀၉၁'), ('BD', '১২১৪'), ('IN', '४००००१'),

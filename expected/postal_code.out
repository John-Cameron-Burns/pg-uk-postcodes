-- D6W breaks the letter-digit-digit routing key shape
SELECT 'IE-B65'::postal_code;
ERROR:  cannot parse "B65" as a IE postal code
LINE 1: SELECT 'IE-B65'::postal_code;
               ^
SELECT 'IE-D6X'::postal_code;

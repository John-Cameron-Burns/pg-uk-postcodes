-- a lock to a country with nothing assigned is accepted (a column definition
-- has to survive a restore before the assignment data does) but nothing can
-- ever go into it
CREATE TEMP TABLE nowhere (pc postal_code('ZZ'));
INSERT INTO nowhere VALUES ('ZZ-12345');
ERROR:  "ZZ" is not a supported country code
LINE 1: INSERT INTO nowhere VALUES ('ZZ-12345');
                                    ^
HINT:  see postal_code_country_formats, or add one with add_country_format()
SELECT is_valid('12345', 'ZZ') AS can_anything_be_valid_there;
 can_anything_be_valid_there 
-----------------------------
 f
(1 row)

-- ===== Templated formats =====================================================
-- A country made of fixed-width digit/letter groups needs only an SQL row.
--
-- First, a template that was rolled back must not be remembered. The first free slot is
-- NAN in the first transaction and ANA in the second, and the backend caches
-- what a slot means; the second must not see the first.
BEGIN;
SELECT add_country_template('XA', 'NAN');
 add_country_template 
----------------------
 
(1 row)

SELECT 'XA-1A2'::postal_code;
 postal_code 
-------------
 XA-1A2
(1 row)

ROLLBACK;
BEGIN;
SELECT add_country_template('XA', 'ANA');
 add_country_template 
----------------------
 
(1 row)

SELECT 'XA-A1A'::postal_code;
 postal_code 
-------------
 XA-A1A
(1 row)

SAVEPOINT s;
SELECT 'XA-1A2'::postal_code;
ERROR:  cannot parse "1A2" as a template "ANA" postal code
LINE 1: SELECT 'XA-1A2'::postal_code;
               ^
ROLLBACK TO s;
ROLLBACK;
SELECT 'XA-A1A'::postal_code;
ERROR:  "XA" is not a supported country code
LINE 1: SELECT 'XA-A1A'::postal_code;
               ^
HINT:  see postal_code_country_formats, or add one with add_country_format()
SELECT count(*) AS user_templates_after_rollbacks FROM postal_code_templates WHERE NOT builtin;
 user_templates_after_rollbacks 
--------------------------------
                              0
(1 row)

-- templates that are not templates
SELECT postal_code_template_check('NNNNN[-NNNN]') AS ok, postal_code_template_check('X') AS also_ok;
      ok      | also_ok 
--------------+---------
 NNNNN[-NNNN] | X
(1 row)

SELECT postal_code_template_check('');
ERROR:  invalid postal code template "": a template cannot be empty
HINT:  N is a digit, A a letter, X either; ' ' and '-' are separators; one optional [ ] group may end it, e.g. "NNNNN[-NNNN]"
SELECT postal_code_template_check('nn');
ERROR:  invalid postal code template "nn": a template is made of N (digit), A (letter), X (digit or letter), separators ' ' and '-', one optional [ ] group at the end, and CC first for the country's own
HINT:  N is a digit, A a letter, X either; ' ' and '-' are separators; one optional [ ] group may end it, e.g. "NNNNN[-NNNN]"
SELECT postal_code_template_check('NN-');
ERROR:  invalid postal code template "NN-": a separator must be followed by a letter or digit, or be the first thing inside [ ]
HINT:  N is a digit, A a letter, X either; ' ' and '-' are separators; one optional [ ] group may end it, e.g. "NNNNN[-NNNN]"
SELECT postal_code_template_check('NN[N');
ERROR:  invalid postal code template "NN[N": missing "]"
HINT:  N is a digit, A a letter, X either; ' ' and '-' are separators; one optional [ ] group may end it, e.g. "NNNNN[-NNNN]"
SELECT postal_code_template_check('NN[N][N]');
ERROR:  invalid postal code template "NN[N][N]": nothing may follow the closing "]"
HINT:  N is a digit, A a letter, X either; ' ' and '-' are separators; one optional [ ] group may end it, e.g. "NNNNN[-NNNN]"
SELECT postal_code_template_check('XXXXXXXXXX');
ERROR:  invalid postal code template "XXXXXXXXXX": template does not fit in the 48 bits available
HINT:  N is a digit, A a letter, X either; ' ' and '-' are separators; one optional [ ] group may end it, e.g. "NNNNN[-NNNN]"
\set VERBOSITY terse
SELECT add_country_template('XA', 'NN?');
ERROR:  invalid postal code template "NN?": a template is made of N (digit), A (letter), X (digit or letter), separators ' ' and '-', one optional [ ] group at the end, and CC first for the country's own
